        {
          "name": "View Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Проверяем, что у ответа есть поле Items (массив)\r",
                  "pm.test(\"Response has Items array\", function () {\r",
                  "    var response = pm.response.json();\r",
                  "    pm.expect(response).to.have.property('Items');\r",
                  "    pm.expect(response.Items).to.be.an('array');\r",
                  "});\r",
                  "\r",
                  "// Проверяем, есть ли товары в корзине\r",
                  "pm.test(\"Cart contains at least one item\", function () {\r",
                  "    var response = pm.response.json();\r",
                  "    pm.expect(response.Items.length).to.be.above(0);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "// Логируем количество товаров\r",
                  "var response = pm.response.json();\r",
                  "console.log(\"Товаров в корзине: \" + response.Items.length);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
